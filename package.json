{
  "name": "tiktok-trex-live",
  "version": "1.0.0",
  "description": "Game khủng long T-Rex tương tác theo quà tặng TikTok Live (Express + Socket.io + tiktok-live-connector)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:env": "node --env-file=.env server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "tiktok-live-connector": "^2.5.0"
  }
}
